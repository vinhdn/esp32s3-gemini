<?xml version="1.0" encoding="utf-8"?>
<!-- Speedometer/HUD motif for Car Nav: gauge ring + needle + tick marks,
     within the adaptive-icon safe zone (inner ~66dp of the 108dp canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gauge outer ring -->
    <path
        android:pathData="M54,25 A29,29 0 1,1 53.99,25 Z"
        android:fillColor="#00000000"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="5.5" />

    <!-- Tick marks around the bottom arc -->
    <path
        android:pathData="M29,74 L34,69"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,84 L54,77"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M79,74 L74,69"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Needle pointing to upper-right (speed indicator) -->
    <path
        android:pathData="M54,54 L73,36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Center hub -->
    <path
        android:pathData="M54,54 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#FFFFFF" />
</vector>
